<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/light_gray"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- CardView -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardView"
        android:layout_width="381dp"
        android:layout_height="759dp"
        android:layout_gravity="center"
        app:cardBackgroundColor="@color/transparent_light_gray"
        app:cardCornerRadius="15dp"
        app:cardElevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/input_section"
            android:layout_width="360dp"
            android:layout_height="747dp"
            android:layout_gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textView5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="25dp"
                android:text="My Expense Tracker"
                android:textColor="@color/black"
                android:textSize="35sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@+id/input_section"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.483"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.208" />

            <TextView
                android:id="@+id/textView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="15dp"
                android:fontFamily="sans-serif-black"
                android:text="Enter Current Date:"
                android:textColor="#0E0E0E"
                android:textColorHint="@color/hint_text_color"
                android:textSize="18sp"
                android:textStyle="bold" />


            <EditText
                android:id="@+id/date"
                android:layout_width="250dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:layout_marginTop="15dp"
                android:background="@drawable/edit_background"
                android:hint="DD/MM/YYYY"
                android:inputType="text"
                android:padding="12dp"
                android:textColor="#130D0D"
                android:textColorHint="@color/hint_text_color"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="15dp"
                android:fontFamily="sans-serif-black"
                android:text="Expense Type :"
                android:textColor="#191818"
                android:textColorHint="@color/hint_text_color"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/Expense"
                android:layout_width="330dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:layout_marginTop="15dp"
                android:background="@drawable/edit_background"
                android:hint="Enter your Expense Type "
                android:padding="12dp"
                android:textColor="#130D0D"
                android:textColorHint="@color/hint_text_color"
                android:textSize="14sp" />


            <TextView
                android:id="@+id/textView3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="15dp"
                android:fontFamily="sans-serif-black"
                android:text=" Amount of the Expense :"
                android:textColor="#0B0A0A"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/Amount"
                android:layout_width="250dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:layout_marginTop="15dp"
                android:background="@drawable/edit_background"
                android:hint="Enter Amount "
                android:padding="12dp"
                android:textColor="#130D0D"
                android:textColorHint="@color/hint_text_color"
                android:textSize="14sp" />


            <Button
                android:id="@+id/addButton"
                android:layout_width="212dp"
                android:layout_height="47dp"
                android:layout_gravity="center"
                android:layout_marginTop="15dp"
                android:background="@drawable/button_background"
                android:text="Add Details"
                android:textColor="@color/white"
                android:textSize="16dp"
                android:textStyle="bold"/>


            <Button
                android:id="@+id/btnViewData"
                android:layout_width="209dp"
                android:layout_height="46dp"
                android:layout_gravity="center"
                android:layout_marginTop="15dp"
                android:background="@drawable/button_background"
                android:text="View All Data"
                android:textColor="@color/white"
                android:textSize="16dp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textView4"
                android:layout_width="295dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:layout_marginTop="15dp"
                android:fontFamily="sans-serif-medium"
                android:text=" Any DATA Update Or Delete Can You Use This Area"
                android:textAlignment="center"
                android:textColor="#000000"
                android:textStyle="bold"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/update"
                android:layout_width="250dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:layout_marginTop="10dp"
                android:background="@drawable/edit_background"
                android:hint="Enter Exiting ID"
                android:padding="12dp"
                android:textColor="#130D0D"
                android:textColorHint="@color/hint_text_color"
                android:textSize="14sp" />


            <Button
                android:id="@+id/btnUpdate"
                android:layout_width="214dp"
                android:layout_height="45dp"
                android:layout_gravity="center"
                android:layout_marginTop="15dp"
                android:background="@drawable/button_background"
                android:text="Update data"
                android:textColor="@color/white"
                android:textSize="16dp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnDelete"
                android:layout_width="212dp"
                android:layout_height="47dp"
                android:layout_gravity="center"
                android:layout_marginTop="15dp"
                android:background="@drawable/button_background"
                android:text="Delete Data"
                android:textColor="@color/white"
                android:textSize="16dp"
                android:textStyle="bold" />


        </LinearLayout>
    </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>